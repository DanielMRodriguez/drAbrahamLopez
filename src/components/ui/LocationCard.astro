---
interface Props {
	mapUrl: string;
	mapQuery: string;
	zone: string;
	name: string;
	hospital: string;
	address: string;
	price: string;
	href: string;
}

const { mapUrl, mapQuery, zone, name, hospital, address, price, href } = Astro.props;
const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
---

<div class="ubi-card">
	<a class="ubi-map" href={mapUrl} target="_blank" rel="noopener noreferrer" aria-label={`Ver ${name} en Google Maps`}>
		<iframe src={embedSrc} width="100%" height="100%" style="border:0;pointer-events:none;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Mapa — ${name}`} />
	</a>
	<div class="ubi-body">
		<div class="ubi-zone">{zone}</div>
		<div class="ubi-name">{name}</div>
		<div class="ubi-hosp">{hospital}</div>
		<div class="ubi-addr" set:html={address} />
		<span class="ubi-price">{price}</span><br style="margin-bottom:10px" />
		<a href={href} class="ubi-link">Ver horarios y cómo llegar →</a>
	</div>
</div>
