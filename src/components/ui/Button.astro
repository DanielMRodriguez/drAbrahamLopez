---
interface Props {
	href: string;
	variant?: 'outline' | 'ghost' | 'white-outline' | 'wa' | 'teal';
	class?: string;
	target?: string;
}

const { href, variant = 'outline', class: className, target } = Astro.props;

const variantClass = {
	outline: 'btn-outline',
	ghost: 'btn-ghost',
	'white-outline': 'btn-white-outline',
	wa: 'btn-wa',
	teal: 'btn-teal',
}[variant];

const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
---

<a href={href} class:list={[variantClass, className]} target={target} rel={rel}>
	<slot />
</a>
