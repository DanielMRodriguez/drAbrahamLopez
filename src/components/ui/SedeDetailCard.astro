---
import Button from "./Button.astro";

interface InfoRow {
  label: string;
  value: string;
  compact?: boolean;
}

interface Props {
  sedeNumber: string;
  sedeLabel: string;
  mapQuery: string;
  zone: string;
  name: string;
  infoRows: InfoRow[];
  zoneChips: string[];
  ctaText: string;
  ctaHref: string;
  ctaTarget?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  sedeNumber,
  sedeLabel,
  mapQuery,
  zone,
  name,
  infoRows,
  zoneChips,
  ctaText,
  ctaHref,
  ctaTarget,
  secondaryText = "Cómo llegar →",
  secondaryHref = "#",
} = Astro.props;

const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
---

<div class="sede-divider">
  <div class="sede-divider-line"></div>
  <div class="sede-divider-num">SEDE {sedeNumber} · {sedeLabel}</div>
  <div class="sede-divider-line"></div>
</div>
<div class="ubi-detail">
  <div class="ubi-detail-map">
    <iframe
      src={embedSrc}
      width="100%"
      height="100%"
      style="border:0;"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`Mapa — ${name}`}
    />
  </div>
  <div class="ubi-detail-info">
    <div class="ubi-zone">{zone}</div>
    <h2>{name}</h2>
    {
      infoRows.map((row) => (
        <div class="info-row">
          <div class="info-label">{row.label}</div>
          <div
            class="info-value"
            style={row.compact ? "font-size:13px;" : undefined}
            set:html={row.value}
          />
        </div>
      ))
    }
    <div class="info-row">
      <div class="info-label">Zonas</div>
      <div class="info-value">
        <div class="zone-chips">
          {zoneChips.map((chip) => <span class="zone-chip">{chip}</span>)}
        </div>
      </div>
    </div>
    <div class="ubi-actions">
      <Button href={ctaHref} variant="teal" target={ctaTarget}>{ctaText}</Button>
      <Button href={secondaryHref} variant="outline">{secondaryText}</Button>
    </div>
  </div>
</div>
