---
interface Props {
  tag: string;
  heading: string;
  paragraphs: string[];
  facts: string[];
  image: string;
  imageAlt: string;
}

const { tag, heading, paragraphs, facts, image, imageAlt } = Astro.props;
---

<section class="container-fluid bg-white section">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="two-col">
          <div class="two-col-content">
            <span class="sect-tag">{tag}</span>
            <h2 class="section-h" style="margin-bottom:14px;">{heading}</h2>
            {paragraphs.map((p) => <p set:html={p} />)}
            <div class="fact-strip">
              {
                facts.map((fact) => (
                  <div class="fact-item">
                    <div class="fact-check">
                      <svg viewBox="0 0 11 11">
                        <path d="M1.5 5.5l3 3 5-5" />
                      </svg>
                    </div>
                    <p set:html={fact} />
                  </div>
                ))
              }
            </div>
          </div>
          <div class="two-col-img">
            <img src={image} alt={imageAlt} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
