---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  tag: string;
  heading: string;
  items: FaqItem[];
}

const { tag, heading, items } = Astro.props;
---

<section class="container-fluid bg-white section">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div style="max-width:720px;margin:0 auto;">
          <span class="sect-tag">{tag}</span>
          <h2 class="section-h" style="margin-bottom:28px;" set:html={heading} />
          <div class="faq-list">
            {
              items.map((item) => (
                <div class="faq-item">
                  <div class="faq-q">{item.q}</div>
                  <div class="faq-a">{item.a}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
