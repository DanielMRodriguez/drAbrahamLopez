---
import Button from "../../ui/Button.astro";

interface Props {
  tag: string;
  heading: string;
  paragraphs: string[];
  bullets: string[];
  alsoText: string;
  ctaText: string;
  ctaHref?: string;
  image: string;
  imageAlt: string;
}

const {
  tag,
  heading,
  paragraphs,
  bullets,
  alsoText,
  ctaText,
  ctaHref = "#",
  image,
  imageAlt,
} = Astro.props;
---

<section class="container-fluid bg-white section">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="two-col">
          <div class="two-col-content">
            <span class="sect-tag">{tag}</span>
            <h2 class="section-h" style="margin-bottom:16px;">{heading}</h2>
            {paragraphs.map((p) => <p set:html={p} />)}
            <div class="holep-bullets">
              {
                bullets.map((bullet) => (
                  <div class="hb">
                    <div class="hb-dot">
                      <svg viewBox="0 0 10 10">
                        <path d="M1.5 5l2.5 2.5 5-5" />
                      </svg>
                    </div>
                    <p set:html={bullet} />
                  </div>
                ))
              }
            </div>
            <div class="also-strip" set:html={alsoText} />
            <Button href={ctaHref} variant="teal">{ctaText}</Button>
          </div>
          <div class="two-col-img">
            <img src={image} alt={imageAlt} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
