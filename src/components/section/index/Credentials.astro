---
import SectionTag from "../../ui/SectionTag.astro";
import Button from "../../ui/Button.astro";

interface CredStat {
  value: string;
  suffix?: string;
  decimals?: number;
  label: string;
  color?: string;
}

interface Props {
  tag: string;
  heading: string;
  bio: string;
  stats: CredStat[];
  ctaHref: string;
  ctaText: string;
  photo: string;
  photoAlt: string;
}

const { tag, heading, bio, stats, ctaHref, ctaText, photo, photoAlt } =
  Astro.props;
---

<section
  class="container-fluid section dark"
  style="position:relative;overflow:hidden;"
>
  <div class="dark-glow"></div>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-12 col-lg-8">
        <div class="pe-5">
          <SectionTag tag={tag} heading={heading} headingClass="creds-h" />
          <p class="creds-bio">{bio}</p>
          <div class="creds-stats">
            {
              stats.map((stat) => (
                <div class="cstat">
                  <div
                    class="cstat-num"
                    style={stat.color ? `color:${stat.color}` : undefined}
                  >
                    <span
                      data-countup={stat.value}
                      data-countup-decimals={stat.decimals ?? 0}
                      >0</span
                    >{stat.suffix}
                  </div>
                  <div class="cstat-lbl">{stat.label}</div>
                </div>
              ))
            }
          </div>
          <Button href={ctaHref} variant="white-outline">{ctaText}</Button>
        </div>
      </div>
      <div class="col-12 col-lg-4">
        <div class="creds-photo">
          <img src={photo} alt={photoAlt} class="img-fluid" />
        </div>
      </div>
    </div>
  </div>
</section>
