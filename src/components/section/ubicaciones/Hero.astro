---
import WhatsAppButton from "../../ui/WhatsAppButton.astro";
import { WHATSAPP_URL } from "../../../lib/consts";

interface Props {
  eyebrow?: string;
  title?: string;
  tagline?: string;
  ctaText?: string;
  bgImage?: string;
  trustItems?: string[];
}

const {
  eyebrow = "Consultorio para atenderte",
  title = "Consultorio en CDMX Oriente",
  tagline = "Atención en hospital privado de referencia. Fácil acceso y estacionamiento. Citas disponibles de lunes a sábado.",
  ctaText = "Agendar cita",
  bgImage = "/assets/consultorio.jpg",
  trustItems = [
    "Consulta desde $1,500",
    "Lunes a sábado",
    "Estacionamiento disponible",
    "GNP · AXA · Mapfre y más",
  ],
} = Astro.props;
---

<section class="ubi-hero">
  <div class="ubi-hero-bg">
    <img src={bgImage} alt="" fetchpriority="high" />
  </div>
  <div class="ubi-hero-overlay"></div>
  <div class="ubi-hero-noise"></div>
  <div class="ubi-hero-content">
    <div class="hero-eyebrow">
      <div class="hero-eyebrow-dot"></div>
      <span>{eyebrow}</span>
    </div>
    <h1 set:html={title} />
    <p>{tagline}</p>
    <WhatsAppButton href={WHATSAPP_URL} text={ctaText} />
  </div>
  <div class="ubi-hero-trust">
    {
      trustItems.map((item) => (
        <div class="ubi-hero-trust-item">
          <span>✓</span>
          <span>{item}</span>
        </div>
      ))
    }
  </div>
</section>
