---
import Button from "../ui/Button.astro";
import { WHATSAPP_URL } from "../../lib/consts";
import WhatsAppButton from "../ui/WhatsAppButton.astro";

interface Stat {
  value: string;
  suffix?: string;
  decimals?: number;
  label: string;
  color?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  tagline?: string;
  stats?: Stat[];
  photo?: string;
  photoAlt?: string;
  photoTag?: string;
}

const {
  eyebrow = "Urólogo certificado UNAM · CDMX y EdoMex",
  title = "Cirugía de próstata<br>con <em>láser</em>",
  tagline = "<strong>Dr. Abraham López Venegas.</strong> Más de 700 cirugías HoLEP y ThuFLEP. Pionero en técnica MiLEP en México. Consultorio en La Viga · Iztapalapa, CDMX.",
  stats = [
    { value: "700", suffix: "+", label: "Cirugías HoLEP" },
    { value: "1300", suffix: "+", label: "Reseñas" },
    {
      value: "4.9",
      suffix: "★",
      decimals: 1,
      label: "Calificación",
      color: "var(--amber)",
    },
  ],
  photo = "/assets/dr-retrato-tall.avif",
  photoAlt = "Dr. Abraham López Venegas",
  photoTag = "Dr. Abraham López Venegas · Urólogo CDMX",
} = Astro.props;
---

<section class="container-fluid hero-home">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="hero-wrapper">
          <div class="hero-content">
            <div class="hero-eyebrow">
              <div class="hero-eyebrow-dot"></div>
              <span>{eyebrow}</span>
            </div>
            <h1 set:html={title} />
            <p class="hero-tagline" set:html={tagline} />
            <div class="hero-proof">
              {
                stats.map((stat) => (
                  <div class="hproof-item">
                    <div
                      class="hproof-num"
                      style={stat.color ? `color:${stat.color}` : undefined}
                    >
                      <span
                        data-countup={stat.value}
                        data-countup-decimals={stat.decimals ?? 0}
                        >0</span
                      >
                      <span style="font-size:.55em;">
                        {stat.suffix}
                      </span>
                    </div>
                    <div class="hproof-lbl">{stat.label}</div>
                  </div>
                ))
              }
            </div>
            <div class="hero-ctas">
              <WhatsAppButton href={WHATSAPP_URL} />
              <Button href="/ubicaciones/" variant="ghost"
                >Ver ubicaciones</Button
              >
            </div>
          </div>
          <div class="hero-photo-wrap">
            <img
              src={photo}
              alt={photoAlt}
              class="hero-dr-img"
              fetchpriority="high"
            />
            <div class="hero-photo-tag-wrap">
              <span class="hero-photo-tag">{photoTag}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
