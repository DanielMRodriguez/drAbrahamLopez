---
import ArticleCard from "../../ui/ArticleCard.astro";

interface Article {
  image?: string;
  imageAlt?: string;
  tag: string;
  title: string;
  excerpt: string;
  meta: string;
  href?: string;
  linkText?: string;
}

interface Props {
  heading: string;
  articles: Article[];
}

const { heading, articles } = Astro.props;
---

<section class="container-fluid bg-white section fog">
<div class="container">
    <div class="row">
    <div class="col-12">
      <h2 style="font-size:22px;font-weight:700;color:var(--ink);margin-bottom:24px;">
        {heading}
      </h2>
    </div>
  </div>
  <div class="row g-3">
    {
      articles.map((article) => (
        <div class="col-12 col-md-4">
          <ArticleCard
            image={article.image}
            imageAlt={article.imageAlt}
            tag={article.tag}
            title={article.title}
            excerpt={article.excerpt}
            meta={article.meta}
            href={article.href}
            linkText={article.linkText}
          />
        </div>
      ))
    }
  </div>
</div>
</section>
