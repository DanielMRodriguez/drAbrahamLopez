---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<section class="container-fluid bg-white section">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="post-body e-content">
          <div class="post-summary">
            <p class="post-summary-label">Resumen rápido</p>
            <p class="post-summary-text">{summary}</p>
          </div>
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>
