---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
---

<section class="container-fluid bg-white section fog">
  <div class="container">
    <div class="row">
      <div class="col-12" style="max-width:720px;margin:0 auto;">
        <h2 class="section-h" style="margin-bottom:28px;">{heading}</h2>
        <div class="faq-list">
          {
            items.map((item) => (
              <div class="faq-item">
                <div class="faq-q">{item.question}</div>
                <div class="faq-a">{item.answer}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
