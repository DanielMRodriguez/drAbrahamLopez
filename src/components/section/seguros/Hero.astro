---
import WhatsAppButton from "../../ui/WhatsAppButton.astro";
import { WHATSAPP_URL } from "../../../lib/consts";

interface Props {
  name: string;
  logo: string;
  title: string;
  tagline: string;
  bullets: string[];
  highlight: string;
  image?: string;
  imageAlt?: string;
}

const {
  name,
  logo,
  title,
  tagline,
  bullets,
  highlight,
  image = "/assets/dr-retrato.avif",
  imageAlt = `Dr. Abraham López Venegas — urólogo que acepta ${name}`,
} = Astro.props;
---

<section class="hero-holep">
  <div class="hero-holep-content dark">
    <div class="hero-eyebrow" style="margin-bottom:20px;">
      <div class="hero-eyebrow-dot"></div>
      <span>Convenio con {name}</span>
    </div>
    <div
      class="seguro-logo-badge"
      style="display:inline-flex;align-items:center;justify-content:flex-start;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:14px;padding:16px 22px;margin-bottom:24px;backdrop-filter:blur(4px);"
    >
      <img
        src={logo}
        alt={`Logo de ${name}`}
        loading="eager"
        style="height:56px;width:auto;max-width:240px;object-fit:contain;display:block;"
      />
    </div>
    <h1>{title}</h1>
    <p>{tagline}</p>
    <div class="check-list" style="margin-bottom:26px;">
      {
        bullets.map((b) => (
          <div class="check-item">
            <div class="check-dot">
              <svg viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <p>{b}</p>
          </div>
        ))
      }
    </div>
    <div class="hero-holep-ctas">
      <WhatsAppButton href={WHATSAPP_URL} text="Agendar consulta por WhatsApp" size={16} />
    </div>
    <p
      style="margin-top:22px;font-size:13px;font-weight:600;color:var(--teal);letter-spacing:.01em;"
    >
      {highlight}
    </p>
  </div>
  <div class="hero-holep-img">
    <img src={image} alt={imageAlt} fetchpriority="high" />
  </div>
</section>
