---
import type { SeoBlock } from "../../../data/aseguradoras";

interface Props {
  blocks: SeoBlock[];
}

const { blocks } = Astro.props;
---

<section class="container-fluid section">
  <div class="container">
    <div class="row">
      <div class="col-12 col-lg-9 mx-auto">
        <div class="seo-content">
          {
            blocks.map((block) =>
              block.t === "h2" ? (
                <h2 class="section-h" style="margin-top:40px;margin-bottom:14px;">
                  {block.x}
                </h2>
              ) : (
                <p class="section-p" style="margin-bottom:16px;">
                  {block.x}
                </p>
              ),
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
