---
import { DOCTORALIA_URL } from "../lib/consts";
---

<!-- FOOTER -->
<footer class="container-fluid">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="row gy-4 foot-top">
          <div class="col-12 col-sm-6 col-lg-3 foot-brand">
            <div class="foot-logo-row">
              <img
                src="/assets/logo.avif"
                alt="Dr. Abraham López Venegas"
                class="foot-logo-img"
              />
            </div>
            <p>
              Urólogo certificado · Cirugía de próstata con láser · CDMX y
              Estado de México
            </p>
          </div>
          <div class="col-12 col-sm-6 col-lg-3 foot-col">
            <h4>Procedimientos</h4><ul>
              <li><a href="/holep/">Cirugía HoLEP / ThuFLEP</a></li><li>
                Cálculos urinarios con láser
              </li><li>Circuncisión láser</li><li>
                Salud masculina y andrología
              </li>
            </ul>
          </div>
          <div class="col-12 col-sm-6 col-lg-3 foot-col">
            <h4>Ubicaciones</h4><ul>
              <li>
                <a
                  href="https://maps.app.goo.gl/7VMUsVrLZr8MF9Hh8"
                  target="_blank"
                  rel="noopener">Lindavista · CDMX Norte</a
                >
              </li><li>
                <a
                  href="https://maps.app.goo.gl/V9BRqjUhKBoTTwRh7"
                  target="_blank"
                  rel="noopener">La Viga · Iztapalapa</a
                >
              </li><li>
                <a
                  href="https://maps.app.goo.gl/2yC34YTcfzuhYbF78"
                  target="_blank"
                  rel="noopener">Chalco · EdoMex</a
                >
              </li><li><a href="/ubicaciones/">Mapa y horarios</a></li>
            </ul>
          </div>
          <div class="col-12 col-sm-6 col-lg-3 foot-col">
            <h4>Contacto</h4><ul>
              <li><a href="tel:5528454843">55 2845 4843</a></li><li>
                WhatsApp directo
              </li><li>
                <a href={DOCTORALIA_URL} target="_blank" rel="noopener"
                  >Doctoralia</a
                >
              </li><li>GNP · AXA · Mapfre · BBVA</li>
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <div class="foot-copy">
            © 2026 Dr. Abraham López Venegas · Todos los derechos reservados
          </div>
          <div class="foot-social">
            <a
              class="soc"
              href="https://www.facebook.com/umgrupomedico"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24"
                ><path
                  d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                ></path></svg
              >
            </a>
            <a
              class="soc"
              href="https://www.instagram.com/urologo.abraham/"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24"
                ><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle
                  cx="12"
                  cy="12"
                  r="4"
                  fill="none"
                  stroke="rgba(255,255,255,.35)"
                  stroke-width="2"></circle><circle
                  cx="17.5"
                  cy="6.5"
                  r="1.2"
                  fill="rgba(255,255,255,.35)"></circle></svg
              >
            </a>
            <a
              class="soc"
              href="https://www.tiktok.com/@uroabraham"
              target="_blank"
              rel="noopener"
              aria-label="TikTok"
            >
              <svg viewBox="0 0 24 24"
                ><path
                  d="M16.5 5.6a4.9 4.9 0 0 1-3-2.6h-3v11.6a2.6 2.6 0 1 1-2.6-2.6c.2 0 .4 0 .6.1V9a5.6 5.6 0 1 0 5 5.6V8.9a7.9 7.9 0 0 0 3 .9V6.5c-.4 0-.7-.1-1-.3z"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
