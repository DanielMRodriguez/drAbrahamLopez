---
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import { WHATSAPP_URL } from "../lib/consts";
import { aseguradoras } from "../data/aseguradoras";
---

<!-- NAV -->
<nav class="nav">
  <div class="container">
    <div class="row h-100">
      <div class="col-12">
        <div class="navwrapper">
          <a class="nav-logo" href="/">
            <img
              src="/assets/logo.avif"
              alt="Dr. Abraham López Venegas — Urólogo Metropolitano"
              class="nav-logo-img"
            />
          </a>
          <ul class="nav-links d-none d-lg-flex">
            <li><a class="nav-link" href="/prostata/">Próstata</a></li>
            <li><a class="nav-link" href="/ubicaciones/">Ubicaciones</a></li>
            <li class="nav-item dropdown seguros-dd">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                Convenio con aseguradoras
              </a>
              <ul class="dropdown-menu seguros-dd-menu">
                {
                  aseguradoras.map((a) => (
                    <li>
                      <a
                        class="dropdown-item"
                        href={`/urologos-que-aceptan-${a.slug}/`}
                      >
                        {a.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </li>
            <li><a class="nav-link" href="/perfil/">Dr. Abraham</a></li>
            <li><a class="nav-link" href="/blog/">Blog</a></li>
            <li><a href="tel:5528454843" class="nav-tel">55 2845 4843</a></li>
            <li><WhatsAppButton href={WHATSAPP_URL} text="Agendar cita" /></li>
          </ul>
          <button
            type="button"
            class="nav-burger d-lg-none"
            data-bs-toggle="offcanvas"
            data-bs-target="#mobileNav"
            aria-controls="mobileNav"
            aria-label="Abrir menú"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- NAV MOBILE (offcanvas) -->
<div
  class="offcanvas offcanvas-start nav-offcanvas"
  tabindex="-1"
  id="mobileNav"
  aria-labelledby="mobileNavLabel"
>
  <div class="offcanvas-header">
    <a class="nav-logo" href="/">
      <img
        src="/assets/logo.avif"
        alt="Dr. Abraham López Venegas — Urólogo Metropolitano"
        class="nav-logo-img"
      />
    </a>
    <button
      type="button"
      class="btn-close btn-close-white"
      data-bs-dismiss="offcanvas"
      aria-label="Cerrar"
    ></button>
  </div>
  <div class="offcanvas-body">
    <ul class="nav-offcanvas-links">
      <li><a class="nav-offcanvas-link" href="/prostata/">Próstata</a></li>
      <li><a class="nav-offcanvas-link" href="/ubicaciones/">Ubicaciones</a></li>
      <li>
        <a
          class="nav-offcanvas-link nav-offcanvas-sub-toggle"
          data-bs-toggle="collapse"
          href="#segurosSubmenu"
          role="button"
          aria-expanded="false"
          aria-controls="segurosSubmenu"
        >
          Convenio con aseguradoras
        </a>
        <ul class="collapse nav-offcanvas-sublinks" id="segurosSubmenu">
          {
            aseguradoras.map((a) => (
              <li>
                <a
                  class="nav-offcanvas-link nav-offcanvas-sublink"
                  href={`/urologos-que-aceptan-${a.slug}/`}
                >
                  {a.name}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      <li><a class="nav-offcanvas-link" href="/perfil/">Dr. Abraham</a></li>
      <li><a class="nav-offcanvas-link" href="/blog/">Blog</a></li>
      <li>
        <a href="tel:5528454843" class="nav-offcanvas-link nav-tel">55 2845 4843</a>
      </li>
      <li><WhatsAppButton href={WHATSAPP_URL} text="Agendar cita" /></li>
    </ul>
  </div>
</div>
