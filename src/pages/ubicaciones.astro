---

<Layout title="Consultorios — Dr. Abraham López Venegas · CDMX y EdoMex">
  <Hero {...heroData} />

  <Sedes sedes={sedes} />

  <Insurers
    tag="Aseguradoras aceptadas"
    heading="Trabajamos con<br>tu seguro médico"
    intro="Contáctanos para verificar cobertura en tu sede más cercana."
    logos={insuranceLogos}
    footnote="+ otras aseguradoras. Consulta disponibilidad por WhatsApp."
  />

  <CtaBanner
    title="¿No sabes cuál sede<br>te queda más cerca?"
    text="Escríbenos por WhatsApp y te ayudamos a elegir la sede más conveniente según tu zona."
    whatsappText="Consultar por WhatsApp"
  />
</Layout>
