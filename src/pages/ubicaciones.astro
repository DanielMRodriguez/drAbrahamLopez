---
import Layout from "../layouts/Layout.astro";
import CtaBanner from "../components/section/CtaBanner.astro";
import Hero from "../components/section/ubicaciones/Hero.astro";
import Sedes from "../components/section/ubicaciones/Sedes.astro";
import Insurers from "../components/section/ubicaciones/Insurers.astro";
import { WHATSAPP_URL } from "../lib/consts";
import { breadcrumbListSchema } from "../lib/schema";

const heroData = {
  eyebrow: "Consultorio para atenderte",
  title: "Consultorio en CDMX Oriente",
  tagline:
    "Atención en hospital privado de referencia. Fácil acceso y estacionamiento. Citas disponibles de lunes a sábado.",
  ctaText: "Agendar cita",
  bgImage: "/assets/consultorio.jpg",
  trustItems: [
    "Consulta desde $1,500",
    "Lunes a sábado",
    "Estacionamiento disponible",
    "GNP · AXA · Mapfre y más",
  ],
};

const sedes = [
  {
    sedeNumber: "01",
    sedeLabel: "CDMX ORIENTE",
    mapQuery: "Hospital MAC La Viga, Calz. de la Viga 1174, Iztapalapa, CDMX",
    zone: "CDMX Oriente",
    name: "La Viga · Iztapalapa",
    infoRows: [
      {
        label: "Hospital",
        value: "<strong>Hospital MAC La Viga</strong><br>Consultorio 607",
      },
      {
        label: "Dirección",
        value: "Calz. de la Viga 1174, Col. El Triunfo<br>Iztapalapa, CDMX",
      },
      { label: "Consultorio", value: "<strong>607</strong>" },
      {
        label: "Consulta",
        value: '<strong style="color:var(--teal);">$1,500</strong>',
      },
      { label: "Teléfono", value: "<strong>55 2845 4843</strong>" },
    ],
    zoneChips: ["Iztapalapa", "Oriente CDMX", "Nezahualcóyotl"],
    ctaText: "Agendar cita en La Viga",
    ctaHref: WHATSAPP_URL,
    ctaTarget: "_blank",
    secondaryHref: "#",
  },
];

const insuranceLogos = [
  { src: "/assets/logo-gnp.svg", alt: "GNP Seguros" },
  { src: "/assets/logo-axa.svg", alt: "AXA" },
  { src: "/assets/logo-mapfre.svg", alt: "Mapfre" },
  { src: "/assets/logo-bbva.svg", alt: "BBVA Seguros" },
];

const title = "Consultorio — Dr. Abraham López Venegas · La Viga, Iztapalapa";
const description =
  "Consultorio del Dr. Abraham López Venegas en La Viga · Iztapalapa, CDMX. Consulta desde $1,500. Atención de lunes a sábado. Aseguradoras GNP, AXA, Mapfre y BBVA.";

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Ubicaciones" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    name: "Dr. Abraham López Venegas — Hospital MAC La Viga",
    description,
    url: new URL("/ubicaciones/", Astro.site).toString(),
    image: new URL("/assets/consultorio.jpg", Astro.site).toString(),
    telephone: "+52 55 2845 4843",
    priceRange: "$1,500",
    medicalSpecialty: "Urology",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Calz. de la Viga 1174, Consultorio 607",
      addressLocality: "Iztapalapa",
      addressRegion: "Ciudad de México",
      addressCountry: "MX",
    },
    openingHoursSpecification: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ],
    },
    acceptedInsurance: insuranceLogos.map((logo) => logo.alt),
  },
  breadcrumbListSchema(breadcrumbItems, Astro.site),
];
---

<Layout
  title={title}
  description={description}
  ogImage="/assets/consultorio.jpg"
  schema={schema}
>
  <Hero {...heroData} />

  <Sedes sedes={sedes} />

  <Insurers
    tag="Aseguradoras aceptadas"
    heading="Trabajamos con<br>tu seguro médico"
    intro="Contáctanos para verificar tu cobertura."
    logos={insuranceLogos}
    footnote="+ otras aseguradoras. Consulta disponibilidad por WhatsApp."
  />

  <CtaBanner
    title="¿Listo para agendar<br>tu consulta?"
    text="Escríbenos por WhatsApp y te ayudamos a agendar tu cita en La Viga · Iztapalapa."
    whatsappText="Consultar por WhatsApp"
  />
</Layout>
