---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Specialist from "../../../../components/section/Specialist.astro";
import Breadcrumbs from "../../../../components/section/Breadcrumbs.astro";
import PostHero from "../../../../components/section/blog/PostHero.astro";
import PostBody from "../../../../components/section/blog/PostBody.astro";
import RelatedArticles from "../../../../components/section/blog/RelatedArticles.astro";
import Faq from "../../../../components/section/blog/Faq.astro";
import {
  slugify,
  primaryCategory,
  postHref,
  postMetaLine,
  sortByDateDesc,
  categoryHref,
} from "../../../../lib/blog";
import { breadcrumbListSchema } from "../../../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: {
      categoria: slugify(primaryCategory(post)),
      slug: post.id,
    },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const relatedArticles = sortByDateDesc(
  allPosts.filter((p) => p.id !== post.id),
)
  .slice(0, 2)
  .map((p) => ({
    image: p.data.heroImage,
    imageAlt: p.data.title,
    tag: primaryCategory(p),
    title: p.data.title,
    excerpt: p.data.shortDescription,
    meta: postMetaLine(p),
    href: postHref(p),
  }));

const specialistBadges = [
  "700+ cirugías HoLEP y ThuFLEP",
  "Doctoralia Awards 2022",
  "Doctoralia Awards 2023",
  "CNMU folio 1776",
];

const postUrl = new URL(postHref(post), Astro.site).toString();
const postImageUrl = new URL(post.data.heroImage, Astro.site).toString();
const authorName = "Dr. Abraham López Venegas";

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: primaryCategory(post), href: categoryHref(primaryCategory(post)) },
  { label: post.data.title },
];

const schema: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.metaDescription,
    image: postImageUrl,
    datePublished: post.data.pubDate.toISOString(),
    mainEntityOfPage: postUrl,
    author: {
      "@type": "Person",
      name: authorName,
      url: new URL("/perfil/", Astro.site).toString(),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    name: post.data.title,
    description: post.data.metaDescription,
    url: postUrl,
  },
  breadcrumbListSchema(breadcrumbItems, Astro.site),
];

if (post.data.faqs && post.data.faqs.length > 0) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: post.data.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  });
}
---

<Layout
  title={`${post.data.metaTitle ?? post.data.title} · Blog`}
  description={post.data.metaDescription}
  ogImage={post.data.heroImage}
  ogType="article"
  schema={schema}
>
  <article class="h-entry">
    <span class="p-author visually-hidden">{authorName}</span>
    <time
      class="dt-published visually-hidden"
      datetime={post.data.pubDate.toISOString()}
    >
      {post.data.pubDate.toISOString()}
    </time>
    <a class="u-url visually-hidden" href={postUrl}>
      {post.data.title}
    </a>

    <PostHero
      tag={primaryCategory(post)}
      title={post.data.title}
      meta={postMetaLine(post)}
      bgImage={post.data.heroImage}
    />

    <Breadcrumbs items={breadcrumbItems} />

    <PostBody summary={post.data.summary}>
      <Content />
    </PostBody>
  </article>

  {post.data.faqs && post.data.faqs.length > 0 && (
    <Faq heading="Preguntas frecuentes" items={post.data.faqs} />
  )}

  <Specialist
    photo="/assets/dr-retrato.avif"
    photoAlt="Dr. Abraham López Venegas"
    badges={specialistBadges}
    title="Dr. Abraham López Venegas"
    text="Urólogo especialista en próstata con más de 700 cirugías HoLEP y ThuFLEP realizadas. Certificado por el Consejo Nacional Mexicano de Urología. 3 consultorios en CDMX y Estado de México."
    ctaText="Agendar consulta"
    secondaryHref="/ubicaciones/"
    secondaryText="Ver ubicaciones"
  />

  {relatedArticles.length > 0 && (
    <RelatedArticles heading="Artículos relacionados" articles={relatedArticles} />
  )}
</Layout>
