  {
    icon: `<svg viewBox="0 0 24 24"><path d="M12 21.5s6.5-5.8 6.5-11A6.5 6.5 0 0 0 5.5 10.5c0 5.2 6.5 11 6.5 11z" stroke-linejoin="round"/><path d="M12 7.8v5.2M9.4 10.4h5.2" stroke-linecap="round"/></svg>`,
