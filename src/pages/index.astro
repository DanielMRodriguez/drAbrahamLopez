  },
  {
    icon: `<svg viewBox="0 0 18 18"><path d="M9 2l2 5h5l-4 3 1.5 5L9 12l-4.5 3L6 10 2 7h5z" stroke-linejoin="round"/></svg>`,
    title: "Cálculos urinarios con láser de Tulio",
    text: "Litotricia láser endoscópica para cálculos en riñón, uréter y vejiga. Tecnología de última generación.",
