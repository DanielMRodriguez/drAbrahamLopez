  },
  {
    quote:
      "Excelente médico, resuelve todas las dudas. El precio de la consulta es accesible y la atención de primer nivel.",
    source: "Paciente verificado · Google · Consulta urológica",
  },
];

const insuranceLogos = [
  { src: "/assets/logo-gnp.svg", alt: "GNP Seguros" },
  { src: "/assets/logo-axa.svg", alt: "AXA" },
  { src: "/assets/logo-mapfre.svg", alt: "Mapfre" },
  { src: "/assets/logo-bbva.svg", alt: "BBVA Seguros" },
];

const blogPosts = [
  {
    image: "/assets/psa-analisis.jpg",
    alt: "Por qué se eleva el antígeno prostático",
    tag: "Próstata",
    title: "Por qué se eleva el antígeno prostático (PSA)",
    meta: "19 mayo 2026 · 5 min · Dr. Abraham López Venegas",
    href: "/blog/",
  },
  {
    image: "/assets/sala-laser.jpg",
    alt: "Qué es el antígeno prostático",
    tag: "Próstata",
    title: "Qué es el antígeno prostático y cuándo importa",
    meta: "19 mayo 2026 · 6 min · Dr. Abraham López Venegas",
    href: "/blog/",
  },
  {
    image: "/assets/consultorio.jpg",
    alt: "Engrosamiento de pene quirúrgico",
    tag: "Andrología",
    title: "Engrosamiento de pene quirúrgico y faloplastia",
    meta: "19 mayo 2026 · 6 min · Dr. Abraham López Venegas",
    href: "/blog/",
  },
];

const siteUrl = "https://www.umgrupomedico.com/";
const doctorUrl = `${siteUrl}perfil/`;
const doctorImage = `${siteUrl}assets/dr-retrato.avif`;
const telephone = "+52 55 2845 4843";

const sedeAddresses = [
  {
    "@type": "PostalAddress",
    streetAddress: "Calle Riobamba 639, Consultorio 184",
    addressLocality: "Gustavo A. Madero",
    addressRegion: "Ciudad de México",
    addressCountry: "MX",
  },
  {
    "@type": "PostalAddress",
    streetAddress: "Calz. de la Viga 1174, Consultorio 607",
    addressLocality: "Iztapalapa",
    addressRegion: "Ciudad de México",
    addressCountry: "MX",
  },
  {
    "@type": "PostalAddress",
    streetAddress: "Av. San Isidro 3, Col. La Conchita, Chalco Centro",
    addressLocality: "Chalco",
    addressRegion: "Estado de México",
    addressCountry: "MX",
  },
];

const aggregateRating = {
  "@type": "AggregateRating",
  ratingValue: "4.9",
  reviewCount: "1300",
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Dr. Abraham López Venegas — Urólogo Metropolitano",
    url: siteUrl,
    inLanguage: "es-MX",
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    name: "Dr. Abraham López Venegas — Urólogo Metropolitano",
    url: siteUrl,
    telephone,
    image: doctorImage,
    priceRange: "$800–$1,500",
    medicalSpecialty: "Urology",
    address: sedeAddresses[0],
    aggregateRating,
    department: [
      {
        "@type": "MedicalBusiness",
        name: "Hospital Ángeles Lindavista — Consultorio 184",
        telephone,
        address: sedeAddresses[0],
      },
      {
        "@type": "MedicalBusiness",
        name: "Hospital MAC La Viga — Consultorio 607",
        telephone,
        address: sedeAddresses[1],
      },
      {
        "@type": "MedicalBusiness",
        name: "UM Chalco",
        telephone,
        address: sedeAddresses[2],
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Physician",
    name: "Dr. Abraham López Venegas",
    url: doctorUrl,
    image: doctorImage,
    telephone,
    medicalSpecialty: "Urology",
    aggregateRating,
    memberOf: [
      { "@type": "Organization", name: "Sociedad Mexicana de Urología" },
      { "@type": "Organization", name: "Colegio Nacional Mexicano de Urología" },
      { "@type": "Organization", name: "Confederación Americana de Urología" },
      { "@type": "Organization", name: "Sociedad Internacional de Urología" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Dr. Abraham López Venegas",
    jobTitle: "Urólogo",
    url: doctorUrl,
    image: doctorImage,
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Universidad Nacional Autónoma de México",
    },
    award: ["Doctoralia Awards 2022", "Doctoralia Awards 2023"],
    hasCredential: [
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "Cédula Profesional",
        identifier: "9148863",
      },
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "Cédula de Especialidad en Urología",
        identifier: "12366905",
      },
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory:
          "Certificación del Consejo Nacional Mexicano de Urología",
        identifier: "1776",
      },
    ],
  },
];
---

<Layout
  title="Dr. Abraham López Venegas — Urólogo Metropolitano CDMX"
  description="Urólogo certificado UNAM. Cirugía de próstata con láser HoLEP y ThuFLEP. Consultorios en CDMX y Estado de México."
  schema={schema}
>
  <Hero />

  <TrustStrip items={trustItems} ctaHref="/perfil/" ctaText="Perfil completo" />

  <BentoStats stats={bentoStats} highlights={bentoHighlights} />

  <Procedures
    tag="Áreas de especialización"
    heading="Procedimientos que realizamos"
    ctaHref="/prostata/"
    ctaText="Ver todos los servicios →"
    items={procedures}
  />

  <Credentials
    tag="Formación y certificaciones"
    heading="Dr. Abraham López Venegas — Urólogo certificado UNAM"
    bio="Médico Cirujano egresado de la Facultad de Medicina de la UNAM (Cédula Prof. 9148863). Especialidad en Urología en el Hospital Juárez de México (Cédula Especialidad 12366905). Certificado por el Consejo Nacional Mexicano de Urología, folio vigente 1776. Miembro de la Sociedad Mexicana de Urología, Colegio Nacional Mexicano de Urología, Confederación Americana de Urología y Sociedad Internacional de Urología."
    stats={credentialStats}
    ctaHref="/perfil/"
    ctaText="Conocer trayectoria completa →"
    photo="/assets/dr-retrato.avif"
    photoAlt="Dr. Abraham López Venegas"
  />

  <Locations
    tag="Consultorios"
    heading="3 sedes en CDMX<br>y Estado de México"
    intro="Atención en hospitales privados de referencia. Citas disponibles de lunes a sábado."
    locations={locations}
    ctaHref="/ubicaciones/"
    ctaText="Ver mapa y horarios completos →"
  />

  <Reviews
    tag="Opiniones de pacientes"
    heading="Más de 1,300 opiniones<br>reales de pacientes"
    subtext="Doctoralia Awards — Urólogo mejor valorado de México 2022 y 2023"
    ratingScore="4.9"
    ratingCount="1,300+ reseñas verificadas"
    reviews={reviews}
    footerHref="#"
    footerText="Ver todas las reseñas en Doctoralia →"
  />

  <Insurers
    label="Aseguradoras aceptadas"
    logos={insuranceLogos}
    moreText="+ otras ·"
    moreHref="/ubicaciones/"
    moreLinkText="Ver cobertura →"
  />

  <BlogPreview
    tag="Artículos recientes"
    heading="Información para pacientes"
    ctaHref="/blog/"
    ctaText="Ver todos los artículos →"
    posts={blogPosts}
  />

  <CtaBanner />
</Layout>
